# Quick GPU test - 200 grain specimen, just 10 steps
units           metal
dimension       3
boundary        p p p
atom_style      atomic

read_data       ../data/polycrystal_200grains.data

pair_style      eam/alloy/gpu
pair_coeff      * * ../data/Al_zhou.eam.alloy Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al Al

neighbor        2.0 bin
neigh_modify    every 1 delay 5 check yes

timestep        0.001
velocity        all create 300.0 201 mom yes rot yes dist gaussian
fix             npt_eq all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0
run             10
