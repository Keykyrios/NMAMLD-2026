# Phase 4: Uniaxial Tensile Loading on Polycrystalline Al
# Restart from Phase 3: simulations/equilibrated_polycrystal.restart

units           metal
dimension       3
boundary        p p p
atom_style      atomic

# Read equilibrated restart file
read_restart    equilibrated_polycrystal.restart

# Pair potential for 12 grain atom types
pair_style      eam/alloy
pair_coeff      * * ../data/Al_zhou.eam.alloy Al Al Al Al Al Al Al Al Al Al Al Al

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 5 check yes

# Timestep: 1 fs
timestep        0.001

# Calculate box strain & virial stress
variable        tmp equal "lx"
variable        L0 equal ${tmp}
variable        strain equal "(lx - v_L0) / v_L0"
variable        stress_x equal "-pxx / 10000.0"  # bar to GPa conversion
variable        stress_y equal "-pyy / 10000.0"
variable        stress_z equal "-pzz / 10000.0"

thermo          200
thermo_style    custom step v_strain v_stress_x v_stress_y v_stress_z temp pe press vol lx ly lz

# Dump trajectory snapshots every 1000 steps
dump            tensile_dump all custom 1000 tensile.lammpstrj id type x y z

# Apply uniaxial tensile strain along X axis (erate = 0.01 1/ps = 1e10 1/s -> 20% strain over 20 ps)
# Transverse dimensions Y and Z are relaxed to 0 bar (zero lateral stress state)
fix             deform_x all deform 1 x erate 0.01 remap x
fix             npt_transverse all npt temp 300.0 300.0 0.1 y 0.0 0.0 1.0 z 0.0 0.0 1.0

# Print status header
echo            both
print           "=== STAGE 4: Uniaxial Tensile Deformation (20,000 steps -> 20% Strain) ==="
run             20000

# Save final deformed structure restart
write_restart   tensile_deformed.restart
print           "=== Phase 4 Tensile Simulation Complete ==="
