# Phase 1: Single-Crystal FCC Aluminum Benchmark Test
# Potential: EAM potential for Al (Al_zhou.eam.alloy)
# Goal: Minimize, equilibrate at 300 K, measure energy/pressure/temperature and timesteps/sec benchmark.

units           metal
dimension       3
boundary        p p p
atom_style      atomic

# Create 14x14x14 FCC unit cells (10,976 atoms)
lattice         fcc 4.05
Lattice spacing in x,y,z = 4.05 4.05 4.05
region          box block 0 14 0 14 0 14
create_box      1 box
Created orthogonal box = (0 0 0) to (56.7 56.7 56.7)
  1 by 1 by 1 MPI processor grid
create_atoms    1 box
Created 10976 atoms
  using lattice units in orthogonal box = (0 0 0) to (56.7 56.7 56.7)
  create_atoms CPU = 0.002 seconds

mass            1 26.981539

# Pair potential
pair_style      eam/alloy
pair_coeff      * * ../data/Al_zhou.eam.alloy Al
Reading eam/alloy potential file ../data/Al_zhou.eam.alloy with DATE: 2007-10-12

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 5 check yes

# Initial velocities & Thermo formatting
velocity        all create 300.0 12345 mom yes rot yes dist gaussian
thermo          100
thermo_style    custom step temp pe ke etotal press vol lx ly lz

# Step 1: Energy Minimization
echo            both
print           "=== STAGE 1: Energy Minimization ==="
=== STAGE 1: Energy Minimization ===
minimize        1.0e-15 1.0e-15 1000 10000
